---
import content from "../data/content.json";
const { footer } = content;
const year = 2026;
---

<footer class="relative border-t border-[var(--color-line)]">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-10 md:flex-row md:items-center md:justify-between md:px-8">
    <p class="font-display text-lg text-[var(--color-muted)]">{footer.tagline}</p>
    <div class="flex items-center gap-4 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-[var(--color-faint)]">
      <span>{footer.signature}</span>
      <span class="text-[var(--color-ember)]" aria-hidden="true">/</span>
      <span>&copy; {year}</span>
    </div>
  </div>
  <!-- Oversized wordmark watermark -->
  <div class="pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <p class="-mb-[0.18em] translate-y-[0.12em] text-center font-display text-[22vw] font-semibold leading-none text-[var(--color-surface-2)]">
      LANIER
    </p>
  </div>
</footer>
