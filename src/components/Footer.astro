---
import content from "../data/content.json";
import ThemeToggle from "./ThemeToggle.astro";
const { footer } = content;
const year = 2026;
---

<footer class="relative border-t border-[var(--color-line)]">
  <!-- End of ride: one last hill, then the brake run and the stop block.
       Aspect ratio preserved so the car stays a true circle. -->
  <div class="mx-auto max-w-7xl px-5 pt-12 md:px-8" aria-hidden="true">
    <svg id="footer-brake" viewBox="0 0 1200 140" fill="none" class="block h-auto w-full">
      <path
        id="footer-brake-path"
        d="M0 96 C90 96 130 110 210 110 C300 110 330 30 430 30 C520 30 560 118 680 118 L1096 118"
        stroke="var(--color-ink)"
        stroke-width="1.5"
        vector-effect="non-scaling-stroke"
        pathLength="1"></path>
      <!-- supports under the final hill -->
      <g stroke="var(--color-ink)" stroke-width="1" opacity="0.5">
        <line x1="360" y1="44" x2="360" y2="132"></line>
        <line x1="430" y1="30" x2="430" y2="132"></line>
        <line x1="500" y1="52" x2="500" y2="132"></line>
      </g>
      <!-- brake fins -->
      <g stroke="var(--color-ink)" stroke-width="1" opacity="0.55">
        <line x1="780" y1="118" x2="780" y2="130"></line>
        <line x1="840" y1="118" x2="840" y2="130"></line>
        <line x1="900" y1="118" x2="900" y2="130"></line>
        <line x1="960" y1="118" x2="960" y2="130"></line>
        <line x1="1020" y1="118" x2="1020" y2="130"></line>
      </g>
      <!-- stop block -->
      <rect x="1096" y="104" width="10" height="28" fill="var(--color-ink)" opacity="0.8"></rect>
      <!-- the car, home safe -->
      <circle id="footer-car" cx="1058" cy="118" r="6" fill="var(--color-ember-vivid)"></circle>
    </svg>
    <p id="footer-endline" class="anno mt-4 text-center">{footer.endOfRide}</p>
  </div>

  <div class="mx-auto mt-6 flex max-w-7xl flex-col gap-6 border-t border-[var(--color-line)] px-5 py-10 md:flex-row md:items-center md:justify-between md:px-8">
    <p class="font-display text-lg text-[var(--color-muted)]">{footer.tagline}</p>
    <ThemeToggle />
    <div class="flex items-center gap-4 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-[var(--color-faint)]">
      <span>{footer.signature}</span>
      <span class="text-[var(--color-ember)]" aria-hidden="true">/</span>
      <span>&copy; {year}</span>
    </div>
  </div>
  <!-- Oversized wordmark watermark — purely decorative.
       Rendered via CSS generated content so it's exempt from the (inapplicable)
       text contrast requirement; also hidden from assistive tech. -->
  <div class="wordmark-watermark pointer-events-none select-none overflow-hidden" aria-hidden="true"></div>
</footer>
