---
import content from "../data/content.json";
import ThemeToggle from "./ThemeToggle.astro";
const { footer } = content;
const year = 2026;
---

<footer class="relative border-t border-[var(--color-line)]">
  <!-- End of ride: brake run flattening into the stop block -->
  <div class="mx-auto max-w-7xl px-5 pt-12 md:px-8" aria-hidden="true">
    <svg id="footer-brake" viewBox="0 0 1200 80" preserveAspectRatio="none" fill="none" class="block h-14 w-full">
      <path
        id="footer-brake-path"
        d="M0 26 C220 26 320 56 540 56 L1096 56"
        stroke="var(--color-ink)"
        stroke-width="1.5"
        vector-effect="non-scaling-stroke"
        pathLength="1"></path>
      <!-- brake fins -->
      <g stroke="var(--color-ink)" stroke-width="1" opacity="0.55">
        <line x1="760" y1="56" x2="760" y2="66"></line>
        <line x1="820" y1="56" x2="820" y2="66"></line>
        <line x1="880" y1="56" x2="880" y2="66"></line>
        <line x1="940" y1="56" x2="940" y2="66"></line>
        <line x1="1000" y1="56" x2="1000" y2="66"></line>
      </g>
      <!-- stop block -->
      <rect x="1096" y="42" width="10" height="26" fill="var(--color-ink)" opacity="0.8"></rect>
      <!-- the car, home safe -->
      <circle id="footer-car" cx="1062" cy="56" r="6" fill="var(--color-ember-vivid)"></circle>
    </svg>
    <p id="footer-endline" class="anno mt-4 text-center">{footer.endOfRide}</p>
  </div>

  <div class="mx-auto mt-6 flex max-w-7xl flex-col gap-6 border-t border-[var(--color-line)] px-5 py-10 md:flex-row md:items-center md:justify-between md:px-8">
    <p class="font-display text-lg text-[var(--color-muted)]">{footer.tagline}</p>
    <ThemeToggle />
    <div class="flex items-center gap-4 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-[var(--color-faint)]">
      <span>{footer.signature}</span>
      <span class="text-[var(--color-ember)]" aria-hidden="true">/</span>
      <span>&copy; {year}</span>
    </div>
  </div>
  <!-- Oversized wordmark watermark — purely decorative.
       Rendered via CSS generated content so it's exempt from the (inapplicable)
       text contrast requirement; also hidden from assistive tech. -->
  <div class="wordmark-watermark pointer-events-none select-none overflow-hidden" aria-hidden="true"></div>
</footer>
