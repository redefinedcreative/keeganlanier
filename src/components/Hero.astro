---
import content from "../data/content.json";
import Icon from "./Icon.astro";
const { hero, builds } = content;
---

<section id="top" class="relative flex min-h-screen items-center overflow-hidden">
  <!-- Atmosphere layers -->
  <div class="blueprint absolute inset-0 opacity-60"></div>
  <div class="ember-glow absolute -top-1/4 left-1/2 h-[120vh] w-[120vh] -translate-x-1/2"></div>
  <div
    class="absolute inset-0"
    style="background: radial-gradient(120% 90% at 50% 100%, rgba(16,13,11,0.9), transparent 60%);"
  >
  </div>

  <!-- Coaster-track motif (the lift hill → the drop) -->
  <svg
    class="pointer-events-none absolute bottom-0 right-0 h-[70vh] w-auto opacity-[0.14]"
    viewBox="0 0 600 600"
    fill="none"
    aria-hidden="true"
  >
    <path
      id="coaster-path"
      d="M-20 560 L180 560 C320 560 300 80 420 80 C520 80 520 300 620 300"
      stroke="var(--color-ember)"
      stroke-width="2.5"
    ></path>
    <g stroke="var(--color-ember)" stroke-width="1.5" opacity="0.7">
      <line x1="40" y1="560" x2="40" y2="600"></line>
      <line x1="90" y1="560" x2="90" y2="600"></line>
      <line x1="140" y1="560" x2="140" y2="600"></line>
      <line x1="420" y1="80" x2="420" y2="120"></line>
      <line x1="380" y1="120" x2="380" y2="160"></line>
    </g>
    <circle id="coaster-car" cx="-20" cy="560" r="7" fill="var(--color-ember-soft)"></circle>
  </svg>

  <div class="relative mx-auto w-full max-w-7xl px-5 pt-28 pb-24 md:px-8">
    <p class="kicker mb-7" data-reveal>{hero.kicker}</p>

    <h1 class="display-xl max-w-5xl text-[clamp(2.8rem,8.5vw,7.25rem)]">
      <span class="block" data-reveal>{hero.headlineLead}</span>
      <span class="block" data-reveal>
        <span class="ember-text">{hero.headlineEmber}</span>
        <span class="text-[var(--color-text)]"> {hero.headlineTail}</span>
      </span>
    </h1>

    <p class="mt-8 max-w-2xl text-lg text-[var(--color-muted)] md:text-xl" data-reveal>
      {hero.sub}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal>
      <a
        href={hero.primaryCta.href}
        class="group inline-flex items-center gap-2 bg-[var(--color-ember)] px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.16em] text-[#160c04] transition-transform duration-200 hover:-translate-y-0.5"
      >
        {hero.primaryCta.label}
        <Icon name="arrow" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </a>
      <a
        href={hero.secondaryCta.href}
        class="inline-flex items-center gap-2 border border-[var(--color-line)] px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.16em] text-[var(--color-text)] transition-colors duration-200 hover:border-[var(--color-ember)] hover:text-[var(--color-ember)]"
      >
        {hero.secondaryCta.label}
      </a>
    </div>
  </div>

  <!-- Marquee strip: now showing -->
  <div
    class="absolute inset-x-0 bottom-0 flex items-center justify-between border-t border-[var(--color-line)] bg-[var(--color-bg)]/40 px-5 py-3 backdrop-blur-sm md:px-8"
    data-reveal
  >
    <div class="flex items-center gap-3 overflow-hidden">
      <span class="hidden font-mono text-[0.65rem] uppercase tracking-[0.24em] text-[var(--color-faint)] sm:inline"
        >Now showing</span
      >
      <div class="flex items-center gap-3 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-[var(--color-muted)]">
        {
          builds.items.map((b, i) => (
            <>
              {i > 0 && <span class="text-[var(--color-ember)]">/</span>}
              <span>{b.name}</span>
            </>
          ))
        }
      </div>
    </div>
    <a
      href="#operator"
      aria-label={`${hero.scrollCue} — scroll to content`}
      class="group flex shrink-0 items-center gap-2 font-mono text-[0.65rem] uppercase tracking-[0.24em] text-[var(--color-faint)]"
    >
      <span class="hidden sm:inline" aria-hidden="true">{hero.scrollCue}</span>
      <span class="inline-block h-7 w-4 rounded-full border border-[var(--color-faint)] p-1" aria-hidden="true">
        <span class="mx-auto block h-1.5 w-0.5 animate-bounce rounded-full bg-[var(--color-ember)]"></span>
      </span>
    </a>
  </div>
</section>
