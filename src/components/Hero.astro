---
import content from "../data/content.json";
import Icon from "./Icon.astro";
const { hero, work } = content;
const [annoElev, annoSection] = hero.annotations;
const tb = hero.titleBlock;
---

<section id="top" class="relative flex min-h-screen items-center overflow-hidden">
  <!-- Atmosphere layers -->
  <div class="blueprint absolute inset-0 opacity-60"></div>
  <div class="ember-glow absolute -top-1/4 left-1/2 h-[120vh] w-[120vh] -translate-x-1/2"></div>
  <div
    class="absolute inset-0"
    style="background: radial-gradient(120% 90% at 50% 100%, color-mix(in srgb, var(--bg) 90%, transparent), transparent 60%);"
  >
  </div>

  <!-- Ride schematic: lift hill → drop → runout, drawn as a blueprint elevation.
       Decorative — all load-bearing copy lives in the HTML around it. -->
  <svg
    id="hero-schematic"
    class="pointer-events-none absolute bottom-10 right-0 hidden h-[68vh] w-auto opacity-55 lg:block"
    viewBox="0 0 900 560"
    fill="none"
    aria-hidden="true"
  >
    <!-- track profile: long run-in under the copy, lift hill on the right -->
    <path
      id="coaster-path"
      d="M-20 470 L430 470 L640 132 Q660 108 682 122 C730 160 720 300 800 320 C850 332 862 302 920 296"
      stroke="var(--color-ink)"
      stroke-width="1.5"
      pathLength="1"
    ></path>
    <!-- supports -->
    <g id="hero-supports" stroke="var(--color-ink)" stroke-width="1" opacity="0.55">
      <line x1="500" y1="358" x2="500" y2="530"></line>
      <line x1="570" y1="245" x2="570" y2="530"></line>
      <line x1="682" y1="112" x2="682" y2="530"></line>
      <line x1="800" y1="320" x2="800" y2="530"></line>
      <line x1="880" y1="300" x2="880" y2="530"></line>
    </g>
    <!-- dimension callout: peak elevation -->
    <g id="hero-dim" font-family="var(--font-mono)" font-size="11" letter-spacing="2">
      <line x1="682" y1="108" x2="682" y2="46" stroke="var(--color-faint)" stroke-width="1" stroke-dasharray="3 4"></line>
      <line x1="622" y1="46" x2="742" y2="46" stroke="var(--color-faint)" stroke-width="1"></line>
      <text x="682" y="34" text-anchor="middle" fill="var(--color-faint)">{annoElev}</text>
    </g>
    <!-- section marker along the datum line -->
    <g id="hero-datum" font-family="var(--font-mono)" font-size="11" letter-spacing="2">
      <line x1="-20" y1="530" x2="920" y2="530" stroke="var(--color-ink)" stroke-width="1" opacity="0.4" stroke-dasharray="2 6"></line>
      <text x="24" y="552" fill="var(--color-faint)">{annoSection}</text>
    </g>
    <!-- the car -->
    <circle id="coaster-car" cx="-20" cy="470" r="6" fill="var(--color-ember-vivid)"></circle>
  </svg>

  <div class="relative mx-auto w-full max-w-7xl px-5 pt-28 pb-24 md:px-8">
    <p class="kicker mb-7 hero-rise" style="animation-delay:.05s">{hero.kicker}</p>

    <h1 class="display-xl max-w-5xl text-[clamp(2.8rem,8.5vw,7.25rem)]">
      <span class="block hero-rise" style="animation-delay:.12s">{hero.headlineLead}</span>
      <span class="block hero-rise" style="animation-delay:.19s">
        <span class="ember-text">{hero.headlineEmber}</span>
        <span class="text-[var(--color-text)]"> {hero.headlineTail}</span>
      </span>
    </h1>

    <p class="mt-8 max-w-2xl text-lg text-[var(--color-muted)] md:text-xl hero-rise" style="animation-delay:.28s">
      {hero.sub}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4 hero-rise" style="animation-delay:.36s">
      <a
        href={hero.primaryCta.href}
        class="group inline-flex items-center gap-2 bg-[var(--color-ember)] px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.16em] text-[var(--color-on-accent)] transition-transform duration-200 hover:-translate-y-0.5"
      >
        {hero.primaryCta.label}
        <Icon name="arrow" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </a>
      <a
        href={hero.secondaryCta.href}
        class="inline-flex items-center gap-2 border border-[var(--color-line)] px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.16em] text-[var(--color-text)] transition-colors duration-200 hover:border-[var(--color-ember)] hover:text-[var(--color-ember)]"
      >
        {hero.secondaryCta.label}
      </a>
    </div>
  </div>

  <!-- Drafting title block — the drawing's legend -->
  <div
    class="pointer-events-none absolute bottom-20 right-5 hidden border border-[var(--color-line)] bg-[var(--color-bg)]/70 font-mono text-[0.6rem] uppercase tracking-[0.18em] text-[var(--color-faint)] backdrop-blur-sm lg:block md:right-8 hero-rise"
    style="animation-delay:.5s"
    aria-hidden="true"
  >
    <div class="grid grid-cols-[auto_auto]">
      <span class="border-b border-r border-[var(--color-line)] px-3 py-1.5">DWG</span>
      <span class="border-b border-[var(--color-line)] px-3 py-1.5 text-[var(--color-muted)]">{tb.dwg}</span>
      <span class="border-b border-r border-[var(--color-line)] px-3 py-1.5">REV</span>
      <span class="border-b border-[var(--color-line)] px-3 py-1.5 text-[var(--color-muted)]">{tb.rev}</span>
      <span class="border-b border-r border-[var(--color-line)] px-3 py-1.5">DRAWN BY</span>
      <span class="border-b border-[var(--color-line)] px-3 py-1.5 text-[var(--color-muted)]">{tb.drawnBy}</span>
      <span class="border-r border-[var(--color-line)] px-3 py-1.5">SHEET</span>
      <span class="px-3 py-1.5 text-[var(--color-muted)]">{tb.sheet}</span>
    </div>
  </div>

  <!-- Marquee strip: now showing -->
  <div
    class="absolute inset-x-0 bottom-0 flex items-center justify-between border-t border-[var(--color-line)] bg-[var(--color-bg)]/40 px-5 py-3 backdrop-blur-sm md:px-8 hero-rise"
    style="animation-delay:.44s"
  >
    <div class="flex items-center gap-3 overflow-hidden">
      <span class="hidden font-mono text-[0.65rem] uppercase tracking-[0.24em] text-[var(--color-faint)] sm:inline"
        >Now showing</span
      >
      <div class="flex items-center gap-3 overflow-hidden whitespace-nowrap font-mono text-[0.7rem] uppercase tracking-[0.18em] text-[var(--color-muted)]">
        {
          work.items.map((b, i) => (
            <>
              {i > 0 && <span class="text-[var(--color-ember)]">/</span>}
              <span class="shrink-0">{b.name}</span>
            </>
          ))
        }
      </div>
    </div>
    <a
      href="#work"
      aria-label={`${hero.scrollCue} — scroll to content`}
      class="group flex shrink-0 items-center gap-2 font-mono text-[0.65rem] uppercase tracking-[0.24em] text-[var(--color-faint)]"
    >
      <span class="hidden sm:inline" aria-hidden="true">{hero.scrollCue}</span>
      <span class="inline-block h-7 w-4 rounded-full border border-[var(--color-faint)] p-1" aria-hidden="true">
        <span class="mx-auto block h-1.5 w-0.5 animate-bounce rounded-full bg-[var(--color-ember)]"></span>
      </span>
    </a>
  </div>
</section>
