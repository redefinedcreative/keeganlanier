---
import content from "../data/content.json";
const { philosophy } = content;
---

<section id="philosophy" class="relative overflow-hidden border-t border-[var(--color-line)] py-24 md:py-36">
  <div class="blueprint absolute inset-0 opacity-40"></div>

  <div class="relative mx-auto max-w-7xl px-5 md:px-8">
    <div class="max-w-3xl">
      <p class="kicker mb-5" data-reveal>{philosophy.kicker}</p>
      <h2 class="display-xl text-[clamp(2rem,5vw,4rem)]" data-reveal>{philosophy.heading}</h2>
      <p class="mt-6 text-lg text-[var(--color-muted)]" data-reveal>{philosophy.lede}</p>
    </div>

    <ul class="mt-14 grid gap-px overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)] sm:grid-cols-2">
      {
        philosophy.principles.map((p) => (
          <li
            class="group relative bg-[var(--color-bg)] p-8 transition-colors duration-300 hover:bg-[var(--color-surface)] md:p-10"
            data-reveal
          >
            <div class="flex items-baseline gap-4">
              <span class="font-mono text-sm text-[var(--color-ember)]">{p.no}</span>
              <span class="h-px flex-1 bg-[var(--color-line)] transition-colors duration-300 group-hover:bg-[var(--color-ember)]/40" />
            </div>
            <h3 class="mt-5 font-display text-2xl font-medium text-[var(--color-text)]">{p.title}</h3>
            <p class="mt-3 text-[var(--color-muted)]">{p.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
