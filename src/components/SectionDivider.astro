---
// A shallow track-profile hairline between sections. Used at exactly two
// boundaries — everywhere else sections keep a plain border-t. Restraint.
---

<div class="section-divider" aria-hidden="true">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none" fill="none" class="block h-[60px] w-full">
    <path
      class="divider-path"
      d="M0 44 C150 44 200 14 320 14 C440 14 480 50 620 50 C760 50 800 22 940 22 C1060 22 1100 40 1200 40"
      stroke="var(--color-ink)"
      stroke-width="1"
      opacity="0.5"
      vector-effect="non-scaling-stroke"
      pathLength="1"></path>
  </svg>
</div>
