---
import content from "../data/content.json";
import Icon from "./Icon.astro";
const { builds } = content;

const accentVar = (a: string) => (a === "neon" ? "var(--color-neon)" : "var(--color-ember)");
---

<section id="builds" class="relative border-t border-[var(--color-line)] py-24 md:py-36">
  <div class="ember-glow absolute inset-x-0 top-0 h-[40vh] opacity-50"></div>

  <div class="relative mx-auto max-w-7xl px-5 md:px-8">
    <div class="max-w-3xl">
      <p class="kicker mb-5" data-reveal>{builds.kicker}</p>
      <h2 class="display-xl text-[clamp(2rem,5vw,4rem)]" data-reveal>{builds.heading}</h2>
      <p class="mt-6 text-lg text-[var(--color-muted)]" data-reveal>{builds.lede}</p>
    </div>

    <ul class="mt-14 flex flex-col gap-6">
      {
        builds.items.map((b, i) => (
        <li>
          <a
            href={b.href}
            target="_blank"
            rel="noopener noreferrer"
            class="build-card group relative grid gap-6 overflow-hidden border border-[var(--color-line)] bg-[var(--color-surface)] p-7 transition-all duration-300 hover:-translate-y-1 md:grid-cols-[auto_1fr_auto] md:items-center md:gap-10 md:p-10"
            style={`--accent:${accentVar(b.accent)}`}
            data-reveal
          >
            {/* hover accent wash */}
            <span
              class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              style="background: radial-gradient(80% 120% at 0% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 60%);"
              aria-hidden="true"
            />
            {/* index + ticket notch */}
            <div class="flex items-center gap-5 md:flex-col md:items-start md:gap-3">
              <span class="font-display text-5xl font-semibold leading-none text-[var(--color-faint)] transition-colors duration-300 group-hover:text-[var(--accent)] md:text-6xl">
                0{i + 1}
              </span>
              <span class="font-mono text-[0.65rem] uppercase tracking-[0.22em] text-[var(--color-faint)]">
                {b.type}
              </span>
            </div>

            {/* core */}
            <div class="relative">
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="font-display text-3xl font-semibold text-[var(--color-text)] md:text-4xl">
                  {b.name}
                </h3>
                <span
                  class="rounded-full border px-2.5 py-1 font-mono text-[0.6rem] uppercase tracking-[0.18em]"
                  style="border-color: color-mix(in srgb, var(--accent) 50%, transparent); color: var(--accent);"
                >
                  {b.status}
                </span>
              </div>
              <p class="mt-3 font-display text-lg italic text-[var(--color-text)]/90 md:text-xl">
                “{b.tagline}”
              </p>
              <p class="mt-4 max-w-2xl text-[var(--color-muted)]">{b.body}</p>
            </div>

            {/* action */}
            <div class="flex items-center justify-between gap-4 md:flex-col md:items-end md:justify-center md:text-right">
              <span
                class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-[var(--color-text)] transition-colors duration-300 group-hover:text-[var(--accent)]"
              >
                {b.cta}
                <Icon name="arrow" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </span>
              <span class="font-mono text-[0.7rem] text-[var(--color-faint)]">{b.linkLabel}</span>
            </div>
          </a>
        </li>
        ))
      }
    </ul>

    <!-- Narrative thread -->
    <div
      class="mt-10 flex items-start gap-4 border-l-2 border-[var(--color-ember)] bg-[var(--color-surface)]/40 py-5 pl-6 pr-5"
      data-reveal
    >
      <Icon name="spark" class="mt-1 h-4 w-4 shrink-0 text-[var(--color-ember)]" />
      <p class="max-w-3xl text-[var(--color-muted)] md:text-lg">{builds.thread}</p>
    </div>
  </div>
</section>
