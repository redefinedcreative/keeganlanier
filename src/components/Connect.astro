---
import content from "../data/content.json";
import Icon from "./Icon.astro";
const { connect } = content;
---

<section id="connect" class="relative overflow-hidden border-t border-[var(--color-line)] pt-24 pb-24 md:pt-36 md:pb-32">
  <div class="ember-glow absolute inset-x-0 bottom-0 h-[70vh]"></div>

  <div class="relative mx-auto max-w-7xl px-5 md:px-8">
    <p class="kicker mb-5" data-reveal>{connect.kicker}</p>
    <h2 class="display-xl max-w-4xl text-[clamp(2.4rem,6.5vw,5.5rem)]" data-reveal>{connect.heading}</h2>
    <p class="mt-6 max-w-xl text-lg text-[var(--color-muted)]" data-reveal>{connect.lede}</p>

    <!-- Socials -->
    <ul class="mt-10 flex flex-wrap gap-3" data-reveal>
      {
        connect.socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="group flex h-14 w-14 items-center justify-center border border-[var(--color-line)] text-[var(--color-muted)] transition-colors duration-200 hover:border-[var(--color-ember)] hover:text-[var(--color-ember)]"
            >
              <Icon name={s.icon as any} class="h-5 w-5" />
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Products -->
    <nav class="mt-14 border-t border-[var(--color-line)] pt-10" aria-label="Things I build" data-reveal>
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.24em] text-[var(--color-faint)]">
        Or explore what I build
      </p>
      <ul class="mt-5 flex flex-col gap-px sm:flex-row sm:gap-8">
        {
          connect.products.map((p) => (
            <li>
              <a
                href={p.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-2 py-1 font-display text-xl text-[var(--color-text)] transition-colors duration-200 hover:text-[var(--color-ember)]"
              >
                {p.label}
                <Icon name="arrow" class="h-4 w-4 opacity-0 transition-all duration-200 group-hover:translate-x-0.5 group-hover:opacity-100" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>
