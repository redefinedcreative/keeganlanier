---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

const posts = (
  await getCollection("blog", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Base title="Writing — Keegan Lanier" description="Notes on technology, operations, and building products.">
  <main id="main" class="mx-auto max-w-3xl px-5 pt-28 pb-24 md:px-8">
    <a
      href="/"
      class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-[var(--color-muted)] transition-colors hover:text-[var(--color-ember)]"
    >
      <Icon name="arrow" class="h-3.5 w-3.5 -scale-x-100" /> Back home
    </a>

    <h1 class="display-xl mt-8 text-[clamp(2.4rem,7vw,4rem)]">Writing</h1>
    <p class="mt-4 text-lg text-[var(--color-muted)]">
      Notes on technology, operations, and building products that respect people.
    </p>

    <ul class="mt-14 flex flex-col">
      {
        posts.length === 0 && (
          <li class="border-t border-[var(--color-line)] py-8 text-[var(--color-muted)]">
            Nothing published yet — first piece is on the way.
          </li>
        )
      }
      {
        posts.map((post) => (
          <li class="border-t border-[var(--color-line)]">
            <a href={`/blog/${post.id}/`} class="group block py-8">
              <time class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-[var(--color-faint)]">
                {fmt(post.data.pubDate)}
              </time>
              <h2 class="mt-2 font-display text-2xl font-medium text-[var(--color-text)] transition-colors group-hover:text-[var(--color-ember)] md:text-3xl">
                {post.data.title}
              </h2>
              <p class="mt-2 text-[var(--color-muted)]">{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <Footer />
</Base>
